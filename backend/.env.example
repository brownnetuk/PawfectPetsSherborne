PORT=3000
MONGODB_URI=mongodb://localhost:27017/pawfectpets

# This backend's own publicly-reachable URL (no trailing slash) -- embedded in
# the tracking pixel appended to sent invoice/quote emails, since that's HTML
# a mail client loads later, outside any request context that could supply
# it. Leave unset for local dev (falls back to http://localhost:$PORT, fine
# since nothing outside your machine could load it anyway); set this to the
# real deployed backend URL in production or opened-invoice tracking silently
# 404s.
PUBLIC_API_URL=

# Secret used to derive the AES-256-GCM key for encrypting sensitive fields
# at rest (e.g. Customer.security.alarmInstructionsEncrypted).
# Generate one with: openssl rand -hex 32
ENCRYPTION_KEY=replace-with-a-long-random-secret

# Secret used to sign staff login JWTs. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
