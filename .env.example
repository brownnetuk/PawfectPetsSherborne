# Copy to .env (or paste these into Portainer's stack environment variables)
# before deploying docker-compose.yml.

# --- MongoDB (self-hosted, replacing Atlas) ---
# docker-compose.yml builds MONGODB_URI directly from these two, so avoid
# @ : / ? # characters in the password (they'd need URL-encoding to survive
# inside a connection string) -- letters/digits/- _ are always safe.
MONGO_ROOT_USERNAME=pawfectpets
MONGO_ROOT_PASSWORD=replace-with-a-long-random-password

# --- Backend (copy the existing values from backend/.env when migrating --
# see docker-compose.yml's comment on ENCRYPTION_KEY specifically) ---
ENCRYPTION_KEY=replace-with-a-long-random-secret
JWT_SECRET=replace-with-a-long-random-secret

# --- Public URLs -- the Public Hostnames you set up for this tunnel in the
# Cloudflare Zero Trust dashboard (Networks > Tunnels > this tunnel > Public
# Hostname), NOT the in-network "backend"/"admin"/"frontend" service names ---
PUBLIC_API_URL=https://api.example.com
PUBLIC_INTAKE_URL=https://intake.example.com

# --- Cloudflare Tunnel ---
# Networks > Tunnels > Create a tunnel (Cloudflared) in the Zero Trust
# dashboard, then copy the token it gives you (under the tunnel's "Install
# and run a connector" step -- it's embedded in the install command it
# shows you, the long string after "--token"). Add three Public Hostnames on
# that same tunnel pointing at http://backend:3000, http://admin:80, and
# http://frontend:80 -- those are the in-network service names from
# docker-compose.yml, reachable from cloudflared over the same Docker network.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-your-tunnel-token
